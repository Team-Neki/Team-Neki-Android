# encoding: utf-8

require "tempfile"
require "open3"
require "tmpdir"
require_relative "lib/play_release"
require_relative "lib/play_review_guard"

default_platform(:android)

# ─────────────────────────────────────────────
#  Helpers
# ─────────────────────────────────────────────

BUILD_CONST_PATH = File.expand_path("../build-logic/src/main/java/com/neki/android/buildlogic/const/BuildConst.kt", __dir__)
PACKAGE_NAME = "com.neki.android"

# Firebase 개발기 versionName의 major.minor.patch 부분(fallback 소스). BuildConst.kt를 읽기만 하고 쓰지 않는다.
def read_base_version_name
  content = File.read(BUILD_CONST_PATH)
  match = content.match(/VERSION_NAME\s*=\s*"([^"]+)"/)
  raise "Could not parse VERSION_NAME from #{BUILD_CONST_PATH}" unless match
  match[1]
end

# ─────────────────────────────────────────────
#  Platform
# ─────────────────────────────────────────────

platform :android do

  # ── Lane: firebase_distribute ────────────────
  desc "Build debug APK (CI run number 기반 버전) and distribute via Firebase App Distribution"
  lane :firebase_distribute do
    run_number = ENV.fetch("FASTLANE_VERSION_CODE") { UI.user_error!("FASTLANE_VERSION_CODE(GITHUB_RUN_NUMBER)가 필요합니다") }
    version_name = "#{read_base_version_name}-dev.#{run_number}"

    gradle(
      task:        "assemble",
      build_type:  "Debug",
      project_dir: ".",
      properties: {
        "versionCode" => run_number.to_i,
        "versionName" => version_name,
      },
      print_command: true,
    )

    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    UI.message("APK path: #{apk_path}")

    commit_sha = sh("git rev-parse --short HEAD", log: false).strip

    firebase_app_distribution(
      app:                   ENV["FIREBASE_APP_ID_DEBUG"],
      android_artifact_type: "APK",
      android_artifact_path: apk_path,
      groups:                ENV.fetch("FIREBASE_TESTER_GROUPS", "네키들"),
      release_notes:         "#{version_name} (#{commit_sha})",
      firebase_cli_token:    ENV["FIREBASE_TOKEN"],
    )

    UI.success("Debug APK #{version_name} distributed via Firebase App Distribution.")
  end

  # ── Lane: internal ───────────────────────────
  desc "Explicit internal testing upload (no production tag or GitHub Release)"
  lane :internal do
    version = read_base_version_name
    tree = PlayRelease.capture("git", "rev-parse", "HEAD^{tree}").strip
    upload_play_build(track: "internal", version_name: version, release_name: PlayRelease.candidate_name(version, tree))
  end

  private_lane :upload_play_build do |options|
    require "google/apis/androidpublisher_v3"
    service = Google::Apis::AndroidpublisherV3::AndroidPublisherService
    service.prepend(PlayReviewGuard) unless service.ancestors.include?(PlayReviewGuard)
    version_name = options.fetch(:version_name)
    existing_code = options[:existing_code]

    tracks = %w[production beta alpha internal]
    # fail-closed: 트랙 조회 자체가 실패(인증/네트워크 오류)하면 즉시 배포를 중단한다.
    # "조회 성공 + 결과 없음(빈 트랙)"과 "조회 실패"를 구분해야 한다 — 후자를 빈 배열로
    # 취급하면 실제로는 더 높은 versionCode가 존재하는데도 낮은 값을 재사용해 충돌할 수 있다.
    version_codes = existing_code ? [] : tracks.flat_map do |track|
      begin
        google_play_track_version_codes(package_name: PACKAGE_NAME, track: track)
      rescue => e
        UI.user_error!("#{track} 트랙 versionCode 조회 실패 — 배포를 중단합니다: #{e.message}")
      end
    end
    next_version_code = existing_code || (version_codes.max || 0) + 1
    UI.message("기존 최대 versionCode=#{version_codes.max.inspect} → 다음 versionCode=#{next_version_code}")

    unless existing_code
      gradle(
        task:        "bundle",
        build_type:  "Release",
        project_dir: ".",
        properties: {
          "versionCode" => next_version_code,
          "versionName" => version_name,
        },
        print_command: true,
      )
    end

    aab_path = existing_code ? nil : lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH]
    UI.message("AAB path: #{aab_path}")

    if options.fetch(:track) == "production"
      PlayRelease.ensure_current_main!(PlayRelease::GitHub.new, ENV.fetch("RELEASE_SHA"))
    end

    upload_to_play_store(
      track:                   options[:source_track] || options.fetch(:track),
      aab:                     aab_path,
      skip_upload_aab:          !existing_code.nil?,
      skip_upload_apk:          true,
      version_name:            options.fetch(:release_name, version_name),
      release_status:          "completed",
      track_promote_to:        existing_code ? options.fetch(:track) : nil,
      track_promote_release_status: "completed",
      version_code:            next_version_code,
      metadata_path:           options[:metadata_path],
      skip_upload_metadata:    true,
      skip_upload_changelogs:  options[:metadata_path].nil?,
      skip_upload_images:      true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: false,
    )

    UI.success("AAB versionCode=#{next_version_code} versionName=#{version_name} uploaded to #{options.fetch(:track)}.")
    next_version_code
  end

  desc "Submit production release, then create the exact source tag and tracked GitHub Release"
  lane :deploy_production do
    config = PlayRelease::Config.new
    sha = ENV.fetch("RELEASE_SHA")
    actual_sha = PlayRelease.capture("git", "rev-parse", "HEAD").strip
    UI.user_error!("Checked-out source differs from release merge SHA") unless actual_sha == sha

    runner = PlayRelease::Production.new(
      config: config, sha: sha, tree: PlayRelease.capture("git", "rev-parse", "HEAD^{tree}").strip,
      github: PlayRelease::GitHub.new, play: PlayRelease::Play.new,
    )
    data = runner.run do |existing_code, source_track|
      Dir.mktmpdir("neki-play-notes-") do |directory|
        config.write_metadata(directory)
        upload_play_build(
          track: "production", version_name: config.version, release_name: config.release_name(sha),
          existing_code: existing_code, source_track: source_track, metadata_path: directory,
        )
      end
    end
    UI.success("Production #{config.tag} (#{data.fetch('version_code')}): #{data.fetch('state')}")
  end

  # ── Lane: create_github_release ──────────────
  desc "Create GitHub Release for the pushed vX.Y.Z tag"
  lane :create_github_release do
    tag  = ENV.fetch("GITHUB_REF_NAME") { UI.user_error!("GITHUB_REF_NAME(tag)이 필요합니다") }
    repo = ENV["GITHUB_REPOSITORY"]

    _output, error, status = Open3.capture3("gh", "release", "view", tag, "--repo", repo, "--json", "tagName")
    if status.success?
      UI.important("GitHub Release #{tag} 이미 존재함, 생성 스킵")
      next
    end
    unless error.strip == "release not found"
      UI.user_error!("GitHub Release 조회 실패: #{error.strip}")
    end

    # 직전 태그 찾기 (없으면 전체 로그). v로 시작하는 릴리즈 태그만 대상으로 한다.
    prev_tag = sh("git tag --list 'v*' --sort=-creatordate | grep -v '^#{tag}$' | head -1", log: false).strip
    log_range = prev_tag.empty? ? "HEAD" : "#{prev_tag}...HEAD"

    # 머지 커밋, [release] 버전 업데이트 커밋 제외하고 커밋 메시지 추출
    commits = sh("git log #{log_range} --pretty=%s --no-merges", log: false).strip
    changelog_lines = commits.lines
      .map(&:strip)
      .reject(&:empty?)
      .reject { |line| line.start_with?("Merge ") || line.start_with?("[release]") }
      .join("\n")

    release_notes = <<~NOTES
      ## What's Changed
      #{changelog_lines}

      **Full Changelog**: #{prev_tag.empty? ? tag : "#{prev_tag}...#{tag}"}
    NOTES

    Tempfile.create(["neki-release-notes-", ".md"]) do |notes_file|
      notes_file.write(release_notes)
      notes_file.flush
      draft_option = ENV["GITHUB_RELEASE_DRAFT"] == "true" ? " --draft" : ""
      sh("gh release create #{tag.shellescape} --title #{tag.shellescape} --notes-file #{notes_file.path.shellescape} --repo #{repo.shellescape}#{draft_option}")
    end

    UI.success("GitHub Release #{tag} created.")
  end

  # ── Lane: deploy ─────────────────────────────
  desc "Production deploy (release PR merge workflow)"
  lane :deploy do
    deploy_production
  end

  # ── Lane: deploy_qa ──────────────────────────
  desc "QA deploy: distribute debug APK via Firebase (CI run number 기반 버전)"
  lane :deploy_qa do
    firebase_distribute
  end

end
